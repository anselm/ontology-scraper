MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ontology
# models, in tier order; any one is enough
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
# per-phase overrides. The bulk phases (analyze, judge) run well on haiku at a fortieth of the opus price (measured
# 2026-10-19, devlog); induction, which adjudicates the vocabulary, stays on the default model.
OPENROUTER_MODEL_ANALYZE=anthropic/claude-haiku-5.5
OPENROUTER_MODEL_JUDGE=anthropic/claude-haiku-5.5
OPENROUTER_MODEL_ANALYZE_FALLBACK=anthropic/claude-sonnet-5.5   # second attempt after a parse or truncation failure
# (Anthropic tier equivalents: MODEL_ANALYZE=claude-haiku-5-5, MODEL_JUDGE=claude-haiku-5-5)
# worker
ANALYZE_BUDGET=100
WORKER_INTERVAL_S=60
# alerts: hourly health check (bin/health.mjs, systemd timer on the VM) pushes problems and a daily digest over ntfy
NTFY_TOPIC=anselm-alerts
NTFY_URL=https://ntfy.sh
DIGEST_HOUR=16
