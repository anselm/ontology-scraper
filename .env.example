MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ontology
# models, in tier order; any one is enough
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
# per-phase overrides, e.g. MODEL_ANALYZE=claude-haiku-5-5 or OPENROUTER_MODEL_ANALYZE=anthropic/claude-haiku-5.5
# worker
ANALYZE_BUDGET=100
WORKER_INTERVAL_S=60
